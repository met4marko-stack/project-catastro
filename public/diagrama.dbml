Table personas {
  id int [pk, increment]
  nombre varchar(255) [not null]
  primer_apellido varchar(255) [not null]
  segundo_apellido varchar(255)
  carnet varchar(255) [not null, unique] // Carnet debe ser único por persona
  expedido varchar(5)
  fecha_nacimiento date
  telefono varchar(20)
  ci_fecha_caducidad date
  ci_es_indefinido bool
  created_at timestamptz
  updated_at timestamptz
}

Table users {
  id int [pk, increment]
  email varchar(255) [not null, unique]
  password varchar(255) [not null]
  persona_id int [unique, not null, ref: > personas.id] // Cada usuario es una única persona
  municipio_id int [ref: > municipios.id] // IMPORTANTE: Debe ser NULO para el Super-Admin
  google2fa_secret text
  created_at timestamptz
  updated_at timestamptz
}

Table propietarios {
  id int [pk, increment]
  persona_id int [not null, ref: > personas.id]
  municipio_id int [not null, ref: > municipios.id]
  estado bool
  created_at timestamptz
  updated_at timestamptz
  // Clave única para que una persona no pueda ser registrada dos veces como propietario en el mismo municipio
  //UNIQUE(persona_id, municipio_id)
}

Table municipios {
    id int [pk, increment]
    nombre varchar(255) [not null]
    departamento varchar(255) [not null]
    logo text [not null]
    created_at timestamptz
    updated_at timestamptz
}

Table roles {
    id int [pk, increment]
    name varchar(255) [not null]
    guard_name varchar(255) [not null]
    created_at timestamptz
    updated_at timestamptz
}

Table model_has_roles {
    id int [pk, increment]
    role_id int [not null, ref: > roles.id]
    model_type varchar(255) [not null]
    model_id int [not null]
}

Table permissions {
    id int [pk, increment]
    name varchar(255) [not null]
    guard_name varchar(255) [not null]
    created_at timestamptz
    updated_at timestamptz
}

Table model_has_permissions {
    id int [pk, increment]
    permission_id int [not null, ref: > permissions.id]
    model_type varchar(255) [not null]
    model_id int [not null]
}       

Table role_has_permissions {
    id int [pk, increment]
    role_id int [not null, ref: > roles.id]
    permission_id int [not null]
}

Table planimetrias {
    id int [pk, increment]
    codigo int [not null]
    fecha_aprobacion date
    documento_aprobacion varchar(255)
    municipio_id int [not null, ref: > municipios.id]
    limite_geografico "geometry(Polygon, 4326)" [not null]
    created_at timestamptz
    updated_at timestamptz
}

Table predios {
    id int [pk, increment]
    inmueble_padre_id int [null]
    propiedad_horizontal bool
    numero_unidad varchar(20) 
    codigo_catastral varchar(255)
    numero_plano varchar(50)
    manzano varchar(20)
    lote varchar(20)
    provincia varchar(255)
    centro_poblado varchar (255)
    zona varchar(255)
    sup_levantamiento double //para sup
    sup_testimonio double    //para area_legal
    sup_construida double
    sup_afectada double
    sup_util double
    coordenadas "geometry(Polygon, 4326)" [not null]
    frente_principal double
    agua_potable bool
    energia_electrica bool
    alcantarillado bool
    alumbrado_publico bool
    gas_domiciliario bool   
    material_via varchar(255)
    forma_lote bool
    fotografia_uno text
    fotografia_dos text
    fotografia_tres text
    fotografia_cuatro text
    fotografia_cinco text
    colindante_norte varchar(255)
    colindante_sur varchar(255)
    colindante_este varchar(255)
    colindante_oeste varchar(255)
    planimetria_id int [not null, ref: > planimetrias.id]
    municipio_id int [not null, ref: > municipios.id]
    created_at timestamptz
    updated_at timestamptz
}

Table propietarios_predios {
    id int [pk, increment]
    propietario_id int [not null, ref: > propietarios.id]
    predio_id int [not null, ref: > predio.id]
    estado varchar(255)
    fecha_inicio date
    fecha_fin date
    created_at timestamptz
    updated_at timestamptz
}

Table tramites {
    id int [pk, increment]
    propietario_id int [not null, ref: > propietarios.id]
    predio_id int [not null, ref: > predio.id]
    municipio_id int [not null, ref: > municipios.id]
    usuario_id int [not null, ref: > users.id]
    fecha_ingreso date
    fecha_inspeccion date
    fecha_conclusion date
    hoja_ruta int
    estado varchar(255)
    observaciones text
    created_at timestamptz
    updated_at timestamptz
}

Table certificacion_catastral {
    id int [pk, increment]
    tramite_id int [not null, ref: > tramites.id]
    estado varchar(255)
    observaciones text
    usuario_id int [not null, ref: > users.id]
    propietario_id int [not null, ref: > propietarios.id]
    predio_id int [not null, ref: > predio.id]
    created_at timestamptz
    updated_at timestamptz
}

Table checklist_tramites {
  id int [pk, increment]
  tramite_id int [unique, not null, ref: > tramites.id]
  created_at timestamptz
  updated_at timestamptz
}

Table req_legales {
  id int [pk, increment]
  checklist_id int [unique, not null, ref: > checklist_tramites.id]
  
  formulario_catastral_b bool
  formulario_catastral text
  testimonio_b bool
  testimonio text
  folio_real_b bool
  folio_real text
  cedula_b bool
  cedula text
  formulario_unico_b bool
  formulario_unico text
  certificado_catastral_vigente_b bool
  certificado_catastral_vigente text
}

Table req_impuestos {
  id int [pk, increment]
  checklist_id int [unique, not null, ref: > checklist_tramites.id]
  
  impuesto_uno_b bool
  impuesto_uno text
  impuesto_dos_b bool
  impuesto_dos text
  impuesto_tres_b bool
  impuesto_tres text
  impuesto_cuatro_b bool
  impuesto_cuatro text
  impuesto_cinco_b bool
  impuesto_cinco text
}

Table req_historial {
  id int [pk, increment]
  checklist_id int [unique, not null, ref: > checklist_tramites.id]
  
  testimonio_anterior_b bool
  testimonio_anterior text
  folio_anterior_b bool
  folio_anterior text
  certificado_tradicion_b bool
  certificado_tradicion text
}

Table req_planos {
  id int [pk, increment]
  checklist_id int [unique, not null, ref: > checklist_tramites.id]
  
  lev_georreferenciado_b bool
  lev_georreferenciado text
  plano_lote_b bool
  plano_lote text
  plano_particion_b bool
  plano_particion text
  planos_individuales_b bool
  planos_individuales text
  plano_arquitecto_b bool
  plano_arquitecto text
  plano_fraccionamiento_b bool
  plano_fraccionamiento text
}

Table req_fotografias {
  id int [pk, increment]
  checklist_id int [unique, not null, ref: > checklist_tramites.id]
  
  fotografia_uno_b bool
  fotografia_uno text
  fotografia_dos_b bool
  fotografia_dos text
  fotografia_tres_b bool
  fotografia_tres text
  fotografia_cuatro_b bool
  fotografia_cuatro text
  fotografia_cinco_b bool
  fotografia_cinco text
}

